{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Error",
        "System": "Error"
      }
    },
    "WriteTo": [
      {
        "Name": "File",
        "Args": { "path": "/app/logs/log-.txt", "rollingInterval": "Day" }
      },
      {
        "Name": "Console"
      }
    ]
  },
  "AllowedHosts": "*"
}