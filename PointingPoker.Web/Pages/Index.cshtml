@page
@model IndexModel
@{
    ViewData["Title"] = "Pointing Poker";
}

<div class="row">
    <div class="col-12 col-lg-6">
        <div class="row m-2">
            <div class="col ps-0 pe-0">
                <div id="watch-session-card" class="card text-bg-light text-secondary p-2">
                    <div class="d-flex gap-2">
                        <input id="input-watch-session-id" type="text" maxlength="4" class="form-control w-auto"
                               placeholder="session to watch"/>
                        <button id="btn-watch-session" type="button" class="btn btn-outline-secondary w-auto">watch
                        </button>
                        <div class="card w-25 d-flex justify-content-center text-bg-light text-secondary">
                            <span class="text-center fw-bold p-1" id="watch-session-id">no session</span>
                        </div>
                        <div id="watch-session-votes-card" class="card w-25 d-flex justify-content-center text-bg-light text-secondary">
                            <span class="text-center fw-bold p-1" id="watch-session-votes">no votes</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="row m-2">
            <div id="vote-card" class="card text-bg-light text-secondary px-0">
                <div class="card-header fw-semibold">
                    session: @Model.SessionId
                </div>
                <div class="card-body">
                    <p id="vote-result" class="card-text p-5">waiting</p>
                </div>
            </div>
        </div>
        <div class="row m-2">
            <div class="col ps-0 pe-1">
                <button type="button" id="show-votes-button" class="btn btn-outline-primary py-3 w-100">Show Votes
                </button>
            </div>
            <div class="col ps-1 pe-0">
                <button type="button" id="clear-votes-button" class="btn btn-outline-secondary py-3 w-100">Clear Votes
                </button>
            </div>
        </div>
        <div class="d-flex gap-2 m-2">
            <button type="button" name="green-vote-button" class="btn btn-success w-100 p-3">0.5</button>
            <button type="button" name="green-vote-button" class="btn btn-success w-100">1</button>
            <button type="button" name="green-vote-button" class="btn btn-success w-100">2</button>
        </div>
        <div class="d-flex gap-2 m-2">
            <button type="button" name="green-vote-button" class="btn btn-success w-100 p-3">3</button>
            <button type="button" name="green-vote-button" class="btn btn-success w-100">4</button>
            <button type="button" name="green-vote-button" class="btn btn-success w-100">5</button>
        </div>
        <div class="d-flex gap-2 m-2">
            <button type="button" name="green-vote-button" class="btn btn-success w-100 p-3">6</button>
            <button type="button" name="green-vote-button" class="btn btn-success w-100">7</button>
            <button type="button" name="green-vote-button" class="btn btn-success w-100">8</button>
        </div>
        <div class="d-flex gap-2 m-2">
            <button type="button" name="yellow-vote-button" class="btn btn-warning w-100 p-3">12</button>
            <button type="button" name="yellow-vote-button" class="btn btn-warning w-100 ">16</button>
            <button type="button" name="yellow-vote-button" class="btn btn-warning w-100 ">20</button>

        </div>
        <div class="d-flex gap-2 m-2">
            <button type="button" name="yellow-vote-button" class="btn btn-warning w-100 p-3">24</button>
            <button type="button" name="yellow-vote-button" class="btn btn-warning w-100 ">32</button>
            <button type="button" name="yellow-vote-button" class="btn btn-warning w-100">40</button>
        </div>
        <div class="d-flex gap-2 m-2">
            <button type="button" name="red-vote-button" class="btn btn-danger w-100 p-3 ">60</button>
            <button type="button" name="red-vote-button" class="btn btn-danger w-100 ">80</button>
            <button type="button" name="red-vote-button" class="btn btn-danger w-100 ">100</button>
        </div>
        <div class="d-flex gap-2 m-2">
            <button type="button" id="empty-vote-button" class="btn btn-outline-dark p-3 w-100">I have no idea what
                you guys are talking
                about.
            </button>
        </div>
    </div>
    <div class="col-12 col-lg-6">
        <div id="users" class="row m-2">
            <ul class="list-group w-100" id="user-list">
                <li class="list-group-item d-flex justify-content-between align-items-center">
                    <strong id="my-username">@Model.Username</strong>
                    <span id="my-vote" class="badge big-badge text-secondary">--</span>
                </li>
            </ul>
        </div>
    </div>
</div>

<script src="~/js/signalr/dist/browser/signalr.js"></script>
<script src="~/js/shared.js" asp-append-version="true"></script>
<script src="~/js/signalr-connection.js" asp-append-version="true"></script>
<script src="~/js/events.js" asp-append-version="true"></script>