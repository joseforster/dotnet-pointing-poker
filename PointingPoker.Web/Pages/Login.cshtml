@page
@model LoginModel
@{
    ViewData["Title"] = "Login";
}

<form method="post" class="position-absolute top-50 start-50 translate-middle">
    <div class="card shadow-lg border-0 rounded-4">
        <div class="card-body p-4">
            <div class="row align-items-end">
                <div class="col">
                    <label for="usernameInput" class="form-label fw-semibold">Username</label>
                    <input type="text" class="form-control" id="usernameInput" name="username" required
                           placeholder="your username">
                </div>
                <div class="col">
                    <button type="submit" name="isCreatingSession" value="true" class="btn btn-success w-100">
                        Create Session
                    </button>
                </div>
            </div>
            <hr/>
            <div class="row align-items-end">
                <div class="col">
                    <label for="sessionInput" class="form-label fw-semibold">Session</label>
                    <input type="text" class="form-control" id="sessionInput" name="session"
                           placeholder="session number"/>
                </div>
                <div class="col">
                    <button type="submit" name="isCreatingSession" value="false" class="btn btn-outline-success w-100">
                        Join Session
                    </button>
                </div>
            </div>
            @{
                if (!string.IsNullOrEmpty(Model.Erro))
                {
                    <div class="mt-3">
                        <span class="text-danger">@Model.Erro</span>
                    </div>
                }
            }
        </div>
    </div>
</form>