@page
@model LoginModel
@{
    ViewData["Title"] = "Login";
}

<form method="post" class="position-absolute top-50 start-50 translate-middle">
    <input type="hidden" name="username" value="@Model.Username"/>
    <div class="card shadow-lg border-0 rounded-4">
        <div class="card-body p-4">
            <div class="text-center mb-3">
                <h5 class="fw-semibold mb-1">
                    Welcome back, <span class="text-success">@Model.Username</span>
                </h5>
                <small class="text-muted">
                    Ready to create or join a session?
                </small>
            </div>
            <div class="row my-2 mx-1">
                <button type="submit" asp-page-handler="CreateSession" class="btn btn-success">
                    Create Session
                </button>
            </div>
            <hr/>
            <div class="row my-2 mx-1">
                <label for="sessionInput" class="form-label fw-semibold">Session</label>
                <input type="text" class="form-control" id="sessionInput" name="session"
                       placeholder="your session number"/>
            </div>
            <div class="row my-2 mx-1">
                <button type="submit" asp-page-handler="JoinSession" class="btn btn-outline-success">
                    Join Session
                </button>
            </div>
            @{
                if (!string.IsNullOrEmpty(Model.Erro))
                {
                    <div class="mt-2">
                        <span class="text-danger">@Model.Erro</span>
                    </div>
                }
            }
        </div>
    </div>
</form>