@using System.Diagnostics
<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
    <title>@ViewData["Title"]</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/PointingPoker.styles.css" asp-append-version="true"/>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css"/>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true"/>
    <link rel="icon" type="image/png" href="~/img/pointing-poker-img.png"/>
</head>

<body>
<header>
    <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3">
        <div class="container">
            <span class="navbar-brand text-primary">
                <span class="fs-3 fw-semibold">Pointing</span>
                <span class="fs-3 fw-bold">Poker</span>
                <span class="badge rounded-pill text-bg-success ms-2" id="my-connection-status">connected</span>
            </span>
            @{
                if (User.Identity != null && User.Identity.IsAuthenticated)
                {
                    <form class="d-flex" method="post">
                        <button class="btn btn-outline-danger" asp-page-handler="ExitSession" id="btn-exit-session"
                                onclick="exitSession()" type="submit">Exit Session
                        </button>
                    </form>
                }
            }
        </div>
    </nav>
</header>

<div class="container">
    <main role="main" class="pb-3">
        @RenderBody()
    </main>
</div>

<footer class="border-top footer text-muted">
    <div class="container d-flex justify-content-between">
        <span>
            &copy; @DateTime.Now.Year - <strong>PointingPoker</strong> - @FileVersionInfo.GetVersionInfo(GetType().Assembly.Location).FileVersion - BETA
        </span>
        <div class="d-flex gap-2">
            <a href="https://github.com/joseforster/dotnet-pointing-poker" target="_blank">
                <img src="~/img/github.png" alt="GitHub" width="32" height="32"/>
            </a>
        </div>
        
    </div>
</footer>

<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

</body>
</html>