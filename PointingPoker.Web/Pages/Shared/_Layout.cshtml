@using System.Diagnostics
<!DOCTYPE html>
<html lang="en" data-bs-theme="light">

<head>
    <meta charset="utf-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=5.0"/>
    <meta name="description" content="Real-time planning poker for agile teams. Create sessions, vote on story points, and reveal results simultaneously.">
    <meta name="theme-color" content="#198754">
    <meta name="color-scheme" content="light dark">

    <!-- Open Graph tags for social sharing -->
    <meta property="og:title" content="Pointing Poker">
    <meta property="og:description" content="Real-time agile planning poker for distributed teams">
    <meta property="og:type" content="website">

    <title>@ViewData["Title"]</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/PointingPoker.styles.css" asp-append-version="true"/>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css"/>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true"/>
    <link rel="icon" type="image/png" href="~/img/pointing-poker-img.png"/>
</head>

<body>
<!-- Skip to content link for accessibility -->
<a href="#main-content" class="visually-hidden-focusable btn btn-primary position-absolute top-0 start-0 m-2" style="z-index: 9999;">Skip to main content</a>

<header>
    <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3">
        <div class="container">
            <span class="navbar-brand text-primary">
                <span class="fs-3 fw-semibold">Pointing</span>
                <span class="fs-3 fw-bold">Poker</span>
            </span>
            @{
                if (User.Identity != null && User.Identity.IsAuthenticated)
                {
                    <form class="d-flex" method="post">
                        <button class="btn btn-outline-danger" asp-page-handler="ExitSession" id="btn-exit-session"
                                onclick="exitSession()" type="submit">Exit Session
                        </button>
                    </form>
                }
            }
        </div>
    </nav>
</header>

<div class="container">
    <main id="main-content" role="main" class="pb-3" tabindex="-1">
        @RenderBody()
    </main>
</div>

<footer class="border-top footer text-muted">
    <div class="container d-flex justify-content-between align-items-center flex-wrap gap-2">
        <div class="d-flex align-items-center gap-2">
            <span>
                &copy; @DateTime.Now.Year - <strong>PointingPoker</strong>
            </span>
            <span class="badge bg-secondary">v@(FileVersionInfo.GetVersionInfo(GetType().Assembly.Location).FileVersion)</span>
            <span class="badge text-bg-success" id="my-connection-status">connected</span>
        </div>
        <div class="d-flex align-items-center gap-3">
            <a href="https://github.com/joseforster/dotnet-pointing-poker" target="_blank"
               rel="noopener noreferrer"
               aria-label="View source code on GitHub"
               class="text-decoration-none">
                <img src="~/img/github.png" alt="GitHub" width="32" height="32"/>
            </a>
        </div>
    </div>
</footer>

<script src="~/lib/jquery/dist/jquery.min.js" defer></script>
<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js" defer></script>

</body>
</html>