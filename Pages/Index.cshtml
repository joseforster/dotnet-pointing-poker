@page
@model IndexModel
@{
    ViewData["Title"] = "Pointing Poker";
}

<div class="row">
    <div class="col">
        <div class="row m-2">
            <div class="card">
                <div class="card-body p-5">
                    Resultado da votação.
                </div>
            </div>
        </div>
        <div class="d-flex gap-2 m-2">
            <button type="button" class="btn btn-outline-primary p-2 w-100">Show Votes</button>
            <button type="button" class="btn btn-outline-secondary w-100">Clear Votes</button>
        </div>
        <div class="d-flex gap-2 m-2">
            <button type="button" class="btn btn-success w-100 p-2">0.5</button>
            <button type="button" class="btn btn-success w-100">1</button>
            <button type="button" class="btn btn-success w-100">2</button>
            <button type="button" class="btn btn-success w-100">4</button>
        </div>
        <div class="d-flex gap-2 m-2">
            <button type="button" class="btn btn-warning w-100 p-2">8</button>
            <button type="button" class="btn btn-warning w-100 ">16</button>
            <button type="button" class="btn btn-warning w-100 ">24</button>
            <button type="button" class="btn btn-warning w-100 ">32</button>
        </div>
        <div class="d-flex gap-2 m-2">
            <button type="button" class="btn btn-danger w-100 p-2">40</button>
            <button type="button" class="btn btn-danger w-100 ">60</button>
            <button type="button" class="btn btn-danger w-100 ">80</button>
            <button type="button" class="btn btn-danger w-100 ">100</button>
        </div>
        <div class="d-flex gap-2 m-2">
            <button type="button" class="btn btn-outline-dark p-2 w-100">I have no ideia what you guys are talking
                about.</button>
        </div>
        <div id="users" class="row m-2">
            <strong id="username">@Model.Username</strong>
            <ul id="lista-usuarios">
            </ul>
        </div>
    </div>
</div>
<script src="~/js/signalr/dist/browser/signalr.js"></script>